# =============================================================================
# AI Film Studio — Environment Configuration
# =============================================================================

# Application
APP_NAME=AI-Film-Studio
APP_ENV=development        # development | staging | production
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-in-production

# Database
DATABASE_URL=sqlite:///./ai_film_studio.db
# For PostgreSQL: DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_film_studio

# Redis (Celery task queue)
REDIS_URL=redis://localhost:6379/0

# --- AI Service API Keys ---

# Anthropic (Film Studio agents — required)
ANTHROPIC_API_KEY=

# OpenAI (script generation — optional)
OPENAI_API_KEY=

# ElevenLabs (voice synthesis — optional)
ELEVENLABS_API_KEY=

# Stability AI (image generation — optional)
STABILITY_API_KEY=

# Replicate (media generation — optional)
REPLICATE_API_TOKEN=

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
