# =============================================================================
# Autonomous Agentic AI — Environment Configuration
# =============================================================================

# Application
APP_NAME=Autonomous-Agentic-AI
APP_ENV=development        # development | staging | production
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-in-production

# Database
DATABASE_URL=sqlite:///./autonomous_agentic_ai.db
# For PostgreSQL: DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autonomous_ai

# Redis (used by Film Studio for Celery task queue)
REDIS_URL=redis://localhost:6379/0

# --- AI Service API Keys ---

# Anthropic (Spiritual AI + Film Studio agents)
ANTHROPIC_API_KEY=

# OpenAI (Film Studio script generation)
OPENAI_API_KEY=

# ElevenLabs (Film Studio voice synthesis — optional)
ELEVENLABS_API_KEY=

# Stability AI (Film Studio image generation — optional)
STABILITY_API_KEY=

# Replicate (Film Studio media generation — optional)
REPLICATE_API_TOKEN=

# --- Spiritual AI Settings ---
DEFAULT_LLM_PROVIDER=anthropic
DEFAULT_MODEL=claude-sonnet-4-5-20250929

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]
